NAME nghttp2
VERSION 1.69.0
DEPENDS openssl VERSION 4.0.0
SOURCE URL https://github.com/nghttp2/nghttp2/releases/download/v1.69.0/nghttp2-1.69.0.tar.gz
SHA256 c866b7477cbb7512ab6863a685027adbb1bb8da8fc3bab7429ed43d3281d5aa9
# Upstream's CMake build does not regenerate release Autotools files when
# source staging changes mtimes; no versioned aclocal/automake is needed.
BUILD_SYSTEM CMAKE
CMAKE_DEFINE CMAKE_C_COMPILER=clang
CMAKE_DEFINE CMAKE_INSTALL_LIBDIR=lib
CMAKE_DEFINE CMAKE_POSITION_INDEPENDENT_CODE=ON
CMAKE_ARG "-DCMAKE_PREFIX_PATH=${dep:openssl}"
CMAKE_DEFINE ENABLE_LIB_ONLY=ON
CMAKE_DEFINE BUILD_SHARED_LIBS=OFF
CMAKE_DEFINE BUILD_STATIC_LIBS=ON
CMAKE_DEFINE BUILD_TESTING=OFF
CMAKE_DEFINE ENABLE_FAILMALLOC=OFF
CMAKE_DEFINE ENABLE_DOC=OFF
TARGET nghttp2::nghttp2 STATIC lib/libnghttp2.a INTERFACE include
DEFINES nghttp2::nghttp2 NGHTTP2_STATICLIB
