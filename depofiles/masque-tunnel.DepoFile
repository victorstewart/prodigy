MASQUE_TUNNEL_COMBINED_PATCH_GZIP
actual="$(sha256sum "$patch_file" | awk '{print $1}')"
test "$actual" = 'e2a1aa35820269d70cea5730330167647896d1b42d9135fd5a50f168afdbdc19'
patch --batch -d "$DEPO_SOURCE_DIR" -p1 < "$patch_file"
cargo build --locked --release --bin masque-tunnel --target-dir "${DEPO_BUILD_DIR}/cargo-target"
EOF
STAGE_FILE BUILD cargo-target/release/masque-tunnel bin/masque-tunnel
ARTIFACT bin/masque-tunnel
