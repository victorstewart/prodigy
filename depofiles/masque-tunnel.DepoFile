MASQUE_TUNNEL_COMBINED_PATCH_GZIP
actual="$(sha256sum "$patch_file" | awk '{print $1}')"
test "$actual" = '59743766c7628d0e38637c34361453aeb7b420628e6303721fd25cae7fdaf284'
