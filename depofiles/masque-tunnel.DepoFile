BUILD_SYSTEM CARGO
DEPENDS rust_toolchain VERSION 1.97.1
CARGO_BUILD_SH <<'EOF'
export PATH="${dep:rust_toolchain}/bin:$PATH"
export RUSTC="${dep:rust_toolchain}/bin/rustc"
export RUSTDOC="${dep:rust_toolchain}/bin/rustdoc"
# Cargo.lock is generated from immutable upstream v0.18.3 plus this verified patch.
lock_file="$DEPO_SOURCE_DIR/Cargo.lock"
base64 -d <<'MASQUE_TUNNEL_V0183_CARGO_LOCK_GZIP' | gzip -dc > "$lock_file"

MASQUE_TUNNEL_V0183_CARGO_LOCK_GZIP
actual="$(sha256sum "$lock_file" | awk '{print $1}')"
test "$actual" = '115605ce3f2c8e456336ae8c57780c5ccca68d6217fa57dc414dc88b90c25b63'
